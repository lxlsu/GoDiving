<view class="app-container">
  <!-- 头部 -->
  <view class="header">
    <text class="title">🤿 潜水日志</text>
    <text class="badge">我的潜水证</text>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-card">
    <text class="stats-label">总潜水次数</text>
    <view class="stats-right">
      <text class="stats-number">{{totalDives}}</text>
      <text class="stats-unit">次</text>
    </view>
  </view>

  <!-- 新增记录表单 -->
  <view class="form-title">
    <text>➕ 新增记录</text>
    <text class="form-tag">日期范围 · 地点 · 次数</text>
  </view>

  <!-- 日期范围 -->
  <view class="input-group">
    <text class="label">潜水日期范围</text>
    <view class="date-range-row">
      <view class="date-box">
        <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
          <view class="picker-content">{{startDate || '开始日期'}}</view>
        </picker>
      </view>
      <text class="date-sep">至</text>
      <view class="date-box">
        <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
          <view class="picker-content">{{endDate || '结束日期'}}</view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 地点与次数 -->
  <view class="row-2col">
    <view class="input-group half">
      <text class="label">地点</text>
      <view class="input-box">
        <input class="input" type="text" placeholder="例如：帕劳" maxlength="30"
               value="{{diveLocation}}" bindinput="onLocationInput" />
      </view>
    </view>
    <view class="input-group half">
      <text class="label">潜水次数</text>
      <view class="input-box">
        <input class="input" type="number" min="1" step="1" placeholder="次数"
               value="{{diveCount}}" bindinput="onCountInput" />
      </view>
    </view>
  </view>

  <view class="error-hint" wx:if="{{showError}}">{{errorMsg}}</view>

  <button class="btn-add" bindtap="addRecord" hover-class="btn-add-hover">保存潜水记录</button>

  <!-- 记录列表区 -->
  <view class="list-header">
    <text class="list-title">📋 潜水记录</text>
    <text class="count-badge">{{recordCount}} 条</text>
  </view>

  <!-- 记录列表 -->
  <view wx:if="{{records.length > 0}}">
    <view class="record-wrapper" wx:for="{{records}}" wx:key="id">
      
      <!-- 右侧背景：删除按钮 -->
      <view class="swipe-delete" data-id="{{item.id}}" bindtap="deleteRecord">
        删除
      </view>

      <!-- 前景内容：可以滑动的部分 -->
      <view class="swipe-content" 
            data-index="{{index}}"
            bindtouchstart="touchStart" 
            bindtouchmove="touchMove" 
            bindtouchend="touchEnd"
            style="transform: translateX({{item.offsetX || 0}}px); transition: {{item.isMoving ? 'none' : 'transform 0.3s ease'}}">
        
        <view class="record-item">
          <view class="record-top">
            <text class="record-place">{{item.location}}</text>
            <text class="total-times">总 {{item.totalCount}} 次</text>
          </view>
          
          <view class="entry-list">
            <view class="entry-row" wx:for="{{item.diveEntries}}" wx:for-item="dive" wx:key="dateStr">
              <text class="entry-date">{{dive.dateStr}}</text>
              <text class="entry-count">{{dive.count}} 次</text>
            </view>
          </view>
        </view>

      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <text class="empty-icon">🌊</text>
    <text>还没有潜水记录，添加你的第一次潜水吧</text>
  </view>

  <view class="footer-note">⚡ 数据保存于本地，随时记录你的每一次下潜</view>
</view>